SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_LANGUAGE=hi
SIMILARITY_THRESHOLD=0.55
TOP_K=10
GENERATION_MODEL=llama-3.1-70b-versatile
EMBEDDING_MODEL=intfloat/multilingual-e5-large
INDEX_DIR=app/data
DATASET_SAMPLE_SIZE=3000

# Retrieval performance — see PRD latency notes. BM25 hybrid measured at
# ~380ms P50 / 200k chunks (rank_bm25 isn't indexed, scans the corpus every
# query); off by default. IVF is ~20x faster than flat FAISS at 200k+ vectors.
ENABLE_BM25_HYBRID=false
FAISS_INDEX_TYPE=flat
FAISS_NLIST=200
FAISS_NPROBE=8
