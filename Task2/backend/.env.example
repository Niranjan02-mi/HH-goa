# ── API Keys ──────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Providers ──────────────────────────────────────────────
LLM_PROVIDER=groq
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_tavily_api_key_here
SIMILARITY_THRESHOLD=0.55
TOP_K=10
GENERATION_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=intfloat/multilingual-e5-large
INDEX_DIR=app/data
DATASET_SAMPLE_SIZE=3000

# Retrieval performance — BM25 hybrid ~380ms P50 at 200k chunks; off by default.
# IVF is ~20x faster than flat FAISS at 200k+ vectors (run scripts/rebuild_ivf_index.py).
ENABLE_BM25_HYBRID=false
FAISS_INDEX_TYPE=ivf
FAISS_NLIST=200
FAISS_NPROBE=8
